# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweetshop
DB_USERNAME=sweetshop
DB_PASSWORD=

# JWT (must be at least 256 bits / 32 chars for HS256)
JWT_SECRET=

# Storage (local or s3)
STORAGE_TYPE=local
STORAGE_BASE_URL=http://localhost:8080/api/v1/files
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Security
ALLOWED_ORIGINS=*
SWAGGER_ENABLED=true

# Rate Limiting
RATE_LIMIT_AUTH=5
RATE_LIMIT_API=60

# Server
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=

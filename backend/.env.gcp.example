# Environment variables for deploying the backend to Google Cloud Run
# with a Neon Postgres database. Copy this to a local .env.gcp (gitignored)
# or export these directly before running scripts/deploy-gcp.sh.
#
# Values below are DUMMY placeholders — replace with your real
# GCP project and Neon connection details before deploying.

# ---- Google Cloud ----
GCP_PROJECT_ID=sweetshop-backend-dummy
GCP_REGION=us-central1
ARTIFACT_REPO=sweetshop
SERVICE_NAME=sweetshop-backend

# ---- Neon Postgres ----
# Use Neon's POOLED connection host (the one with the "-pooler" suffix on
# the Neon dashboard) and disable server-side prepared statements, since
# Neon's pooler runs PgBouncer in transaction mode.
#
# How to find these values on the Neon dashboard:
#   1. Go to https://console.neon.tech -> your project -> "Connection Details"
#   2. Set "Connection type" dropdown to "Pooled" (important!)
#   3. The host shown will have a "-pooler" suffix, e.g.:
#      ep-cool-morning-123456-pooler.us-east-2.aws.neon.tech
#   4. Copy the database name (default: neondb), username, and password
#
# DATABASE_URL format:
#   jdbc:postgresql://<POOLED-HOST>/<DB_NAME>?sslmode=require&prepareThreshold=0
DATABASE_URL=jdbc:postgresql://ep-dummy-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&prepareThreshold=0
DB_USERNAME=neondb_owner
DB_PASSWORD=dummy_password_replace_me

# ---- App secrets ----
JWT_SECRET=replace-with-a-real-256-bit-random-secret-before-deploying
ALLOWED_ORIGINS=*
SWAGGER_ENABLED=false

# ---- File storage ----
# "local" stores files on the Cloud Run container's ephemeral filesystem,
# which is wiped on every new revision/instance — fine for a dummy/test
# deploy, but switch to "s3" (an AWS S3 bucket) or another persistent
# object store before relying on uploaded images in production.
STORAGE_TYPE=local
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto

# ---- Payments (optional) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
